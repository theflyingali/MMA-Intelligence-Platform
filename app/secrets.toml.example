# Copy into the Streamlit Community Cloud "Secrets" box (or .streamlit/secrets.toml at the repo root locally, which is gitignored).
# Never commit real values.
DATABRICKS_HOST = "https://<your-workspace>.cloud.databricks.com"
DATABRICKS_WAREHOUSE_ID = "<warehouse id>"
# Service principal with SELECT on mma.silver only (OAuth M2M):
DATABRICKS_CLIENT_ID = "<application id>"
DATABRICKS_CLIENT_SECRET = "<oauth secret>"
